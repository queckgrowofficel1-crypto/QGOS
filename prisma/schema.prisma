// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// PHASE 1: FINTECH ENUMS (UNCHANGED)
// ============================================================================

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  BANNED
  PENDING_VERIFICATION
}

enum UserRole {
  ADMIN
  MODERATOR
  AGENT
  USER
}

enum WalletType {
  PRIMARY
  SECONDARY
  TRADING
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER
  INVESTMENT
  INCOME
  REFUND
}

enum TransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum PackageType {
  BASIC
  STANDARD
  PREMIUM
  ELITE
  VIP
}

enum PackageStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum InvestmentStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
  MATURED
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
  CANCELLED
}

enum DepositStatus {
  PENDING
  VERIFIED
  COMPLETED
  FAILED
  CANCELLED
}

enum KYCStatus {
  NOT_STARTED
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum KYCDocumentType {
  PASSPORT
  NATIONAL_ID
  DRIVING_LICENSE
  VISA
  RESIDENCE_PERMIT
}

enum OTPType {
  EMAIL_VERIFICATION
  SMS_VERIFICATION
  TWO_FACTOR_AUTH
  PASSWORD_RESET
  WITHDRAWAL
}

enum OTPStatus {
  PENDING
  VERIFIED
  EXPIRED
  INVALID
}

enum RankType {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  DIAMOND
  CROWN
}

enum IncomeType {
  REFERRAL
  BINARY
  MATCHING
  RANK
  BONUS
}

enum NotificationType {
  INFO
  WARNING
  ERROR
  SUCCESS
  TRANSACTION
  SYSTEM
}

enum AuditLogAction {
  CREATE
  READ
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  WITHDRAW
  DEPOSIT
  TRANSFER
}

// ============================================================================
// PHASE 2: AI OPERATING SYSTEM ENUMS
// ============================================================================

enum AIModelProvider {
  OPENAI
  ANTHROPIC
  OPENROUTER
  LOCAL
  HUGGINGFACE
}

enum AIModelType {
  LLM
  EMBEDDING
  IMAGE
  AUDIO
  TEXT_TO_SPEECH
}

enum WorkspaceStatus {
  ACTIVE
  ARCHIVED
}

enum AIAgentType {
  ASSISTANT
  SPECIALIST
  ORCHESTRATOR
  TOOL
}

enum AIAgentStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  TESTING
}

enum ConversationStatus {
  ACTIVE
  ARCHIVED
  COMPLETED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum WorkflowStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  DEPRECATED
}

enum WorkflowTriggerType {
  MANUAL
  SCHEDULED
  WEBHOOK
  EVENT
  API
}

enum WorkflowExecutionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  TIMEOUT
}

enum TaskType {
  AGENT_CALL
  WEBHOOK
  DATA_FETCH
  TRANSFORM
  CONDITION
}

enum TaskStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

enum DocumentStatus {
  DRAFT
  PROCESSING
  READY
  ERROR
}

enum APIKeyType {
  PERSONAL
  SERVICE
  WEBHOOK
}

// ============================================================================
// PHASE 1: CORE USER MODELS (UNCHANGED)
// ============================================================================

model User {
  id                String      @id @default(cuid())
  email             String      @unique
  phone             String?     @unique
  username          String?     @unique
  password          String
  firstName         String?
  lastName          String?
  fullName          String?
  avatar            String?
  dateOfBirth       DateTime?
  gender            String?

  status            UserStatus  @default(PENDING_VERIFICATION)
  role              UserRole    @default(USER)
  isEmailVerified   Boolean     @default(false)
  isPhoneVerified   Boolean     @default(false)
  isTwoFactorEnabled Boolean    @default(false)
  lastLoginAt       DateTime?
  lastLoginIP       String?

  // Referral System
  referrerId        String?
  referrer          User?       @relation("Referrals", fields: [referrerId], references: [id], onDelete: SetNull)
  referrals         User[]      @relation("Referrals")
  referralCode      String?     @unique

  // Phase 1 Relations
  wallets           Wallet[]
  transactions      Transaction[]
  investments       Investment[]
  deposits          Deposit[]
  withdrawals       Withdrawal[]
  kyc               KYC?
  otps              OTP[]
  sessions          Session[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  binaryLeftChild   User?       @relation("BinaryLeft", fields: [binaryLeftChildId], references: [id], onDelete: SetNull)
  binaryLeftChildId String?
  binaryRightChild  User?       @relation("BinaryRight", fields: [binaryRightChildId], references: [id], onDelete: SetNull)
  binaryRightChildId String?
  binaryParent      User?       @relation("BinaryParent", fields: [binaryParentId], references: [id], onDelete: SetNull)
  binaryParentId    String?
  binaryChildren    User[]      @relation("BinaryParent")
  binaryIncome      BinaryIncome[]
  matchingIncome    MatchingIncome[]
  rankRewards       RankReward[]
  referralIncomes   ReferralIncome[]
  roles             Role[]

  // Phase 2 AI-OS Relations
  createdAgents      AIAgent[] @relation("AgentCreatedBy")
  agentVersions      AIAgentVersion[] @relation("VersionCreatedBy")
  conversations      Conversation[] @relation("ConversationUser")
  uploadedDocuments  Document[] @relation("DocumentUploadedBy")
  createdWorkflows   Workflow[] @relation("WorkflowCreatedBy")
  workflowExecutions WorkflowExecution[] @relation("ExecutionBy")
  apiKeys            APIKey[]
  createdWorkspaces  Workspace[] @relation("WorkspaceOwner")
  createdKnowledgeBases KnowledgeBase[] @relation("KnowledgeBaseCreatedBy")

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  deletedAt         DateTime?

  @@index([email])
  @@index([username])
  @@index([phone])
  @@index([referrerId])
  @@index([status])
  @@index([createdAt])
  @@map("users")
}

// ============================================================================
// PHASE 1: WALLET & TRANSACTION MODELS (UNCHANGED)
// ============================================================================

model Wallet {
  id                String      @id @default(cuid())
  userId            String
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  type              WalletType  @default(PRIMARY)
  currency          String      @default("USD")
  balance           Decimal     @default(0) @db.Decimal(18, 8)
  totalDeposited    Decimal     @default(0) @db.Decimal(18, 8)
  totalWithdrawn    Decimal     @default(0) @db.Decimal(18, 8)
  totalEarned       Decimal     @default(0) @db.Decimal(18, 8)

  isActive          Boolean     @default(true)
  lastTransactionAt DateTime?

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  deletedAt         DateTime?

  @@unique([userId, type])
  @@index([userId])
  @@index([isActive])
  @@map("wallets")
}

model Transaction {
  id                String              @id @default(cuid())
  userId            String
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletId          String
  wallet            Wallet              @relation(fields: [walletId], references: [id], onDelete: Cascade)

  type              TransactionType
  status            TransactionStatus   @default(PENDING)
  amount            Decimal             @db.Decimal(18, 8)
  fee               Decimal             @default(0) @db.Decimal(18, 8)
  netAmount         Decimal             @db.Decimal(18, 8)
  currency          String              @default("USD")
  description       String?
  reference         String?             @unique
  metadata          Json?

  // Related models
  depositId         String?
  deposit           Deposit?            @relation(fields: [depositId], references: [id])
  withdrawalId      String?
  withdrawal        Withdrawal?         @relation(fields: [withdrawalId], references: [id])
  investmentId      String?
  investment        Investment?         @relation(fields: [investmentId], references: [id])
  incomeId          String?

  processedAt       DateTime?
  failureReason     String?

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  deletedAt         DateTime?

  @@index([userId])
  @@index([walletId])
  @@index([type])
  @@index([status])
  @@index([reference])
  @@index([createdAt])
  @@map("transactions")
}

// ============================================================================
// PHASE 1: INVESTMENT & PACKAGE MODELS (UNCHANGED)
// ============================================================================

model Package {
  id                String          @id @default(cuid())
  name              String
  type              PackageType
  status            PackageStatus   @default(ACTIVE)
  description       String?

  minAmount         Decimal         @db.Decimal(18, 8)
  maxAmount         Decimal         @db.Decimal(18, 8)
  dailyROI          Decimal         @db.Decimal(5, 2) // Percentage
  monthlyROI        Decimal         @db.Decimal(5, 2)
  yearlyROI         Decimal         @db.Decimal(5, 2)
  maturityPeriodDays Int
  includeReferralBonus Boolean      @default(true)
  referralBonusPercentage Decimal   @default(0) @db.Decimal(5, 2)

  maxInvestors      Int?
  currentInvestors  Int             @default(0)
  displayOrder      Int             @default(0)

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?

  @@index([status])
  @@index([type])
  @@map("packages")
}

model Investment {
  id                String              @id @default(cuid())
  userId            String
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  packageId         String
  package           Package             @relation(fields: [packageId], references: [id])

  status            InvestmentStatus    @default(PENDING)
  amount            Decimal             @db.Decimal(18, 8)
  dailyROI          Decimal             @db.Decimal(5, 2)
  monthlyROI        Decimal             @db.Decimal(5, 2)
  yearlyROI         Decimal             @db.Decimal(5, 2)

  investmentDate    DateTime
  maturityDate      DateTime
  totalReturn       Decimal             @default(0) @db.Decimal(18, 8)
  totalEarned       Decimal             @default(0) @db.Decimal(18, 8)

  isReinvested      Boolean             @default(false)
  reinvestedCount   Int                 @default(0)

  // Relations
  transactions      Transaction[]

  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  deletedAt         DateTime?

  @@index([userId])
  @@index([packageId])
  @@index([status])
  @@index([maturityDate])
  @@index([createdAt])
  @@map("investments")
}

// ============================================================================
// PHASE 1: INCOME MODELS (UNCHANGED)
// ============================================================================

model ReferralIncome {
  id                String          @id @default(cuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  referralUserId    String
  referralUser      User?           @relation(fields: [referralUserId], references: [id], onDelete: SetNull)

  amount            Decimal         @db.Decimal(18, 8)
  percentage        Decimal         @default(0) @db.Decimal(5, 2)
  level             Int             @default(1)
  
  isProcessed       Boolean         @default(false)
  processedAt       DateTime?
  description       String?

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?

  @@index([userId])
  @@index([referralUserId])
  @@index([isProcessed])
  @@index([createdAt])
  @@map("referral_incomes")
}

model BinaryIncome {
  id                String          @id @default(cuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  leftLegAmount     Decimal         @default(0) @db.Decimal(18, 8)
  rightLegAmount    Decimal         @default(0) @db.Decimal(18, 8)
  pairBonus         Decimal         @default(0) @db.Decimal(18, 8)

  isProcessed       Boolean         @default(false)
  processedAt       DateTime?
  period            DateTime        // Month/Period for binary calculation

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?

  @@index([userId])
  @@index([isProcessed])
  @@index([period])
  @@map("binary_incomes")
}

model MatchingIncome {
  id                String          @id @default(cuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  amount            Decimal         @db.Decimal(18, 8)
  percentage        Decimal         @default(0) @db.Decimal(5, 2)
  fromInvestmentId  String?
  level             Int             @default(1)

  isProcessed       Boolean         @default(false)
  processedAt       DateTime?
  description       String?

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?

  @@index([userId])
  @@index([isProcessed])
  @@index([createdAt])
  @@map("matching_incomes")
}

model RankReward {
  id                String          @id @default(cuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  rank              RankType
  amount            Decimal         @db.Decimal(18, 8)
  bonusPercentage   Decimal         @default(0) @db.Decimal(5, 2)

  isProcessed       Boolean         @default(false)
  processedAt       DateTime?
  awardedAt         DateTime

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?

  @@index([userId])
  @@index([rank])
  @@index([isProcessed])
  @@map("rank_rewards")
}

// ============================================================================
// PHASE 1: WITHDRAWAL & DEPOSIT MODELS (UNCHANGED)
// ============================================================================

model Withdrawal {
  id                String              @id @default(cuid())
  userId            String
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  status            WithdrawalStatus    @default(PENDING)
  amount            Decimal             @db.Decimal(18, 8)
  fee               Decimal             @default(0) @db.Decimal(18, 8)
  netAmount         Decimal             @db.Decimal(18, 8)
  currency          String              @default("USD")

  bankAccountName   String?
  bankAccountNumber String?
  bankName          String?
  bankCode          String?
  bankCountry       String?
  
  // Alternative payment methods
  cryptoAddress     String?
  cryptoNetwork     String?
  paymentMethod     String?

  approvedBy        String?
  approvalNote      String?
  rejectionReason   String?

  transactions      Transaction[]
  approvedAt        DateTime?
  completedAt       DateTime?

  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  deletedAt         DateTime?

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("withdrawals")
}

model Deposit {
  id                String          @id @default(cuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  status            DepositStatus   @default(PENDING)
  amount            Decimal         @db.Decimal(18, 8)
  currency          String          @default("USD")
  transactionHash   String?         @unique

  // Payment details
  paymentMethod     String?
  bankName          String?
  bankAccountNumber String?
  cardLast4         String?
  cryptoNetwork     String?
  cryptoAddress     String?

  verifiedBy        String?
  verificationNote  String?
  verifiedAt        DateTime?

  transactions      Transaction[]

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?

  @@index([userId])
  @@index([status])
  @@index([transactionHash])
  @@index([createdAt])
  @@map("deposits")
}

// ============================================================================
// PHASE 1: KYC & VERIFICATION MODELS (UNCHANGED)
// ============================================================================

model KYC {
  id                String              @id @default(cuid())
  userId            String              @unique
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  status            KYCStatus           @default(NOT_STARTED)
  
  // Personal Information
  firstName         String?
  lastName          String?
  dateOfBirth       DateTime?
  nationality       String?
  address           String?
  city              String?
  state             String?
  postalCode        String?
  country           String?

  // Document Information
  documentType      KYCDocumentType?
  documentNumber    String?
  documentIssueDate DateTime?
  documentExpiryDate DateTime?
  documentFrontUrl  String?
  documentBackUrl   String?

  // Verification Details
  verifiedAt        DateTime?
  verifiedBy        String?
  rejectionReason   String?
  expiryDate        DateTime?

  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  deletedAt         DateTime?

  @@index([userId])
  @@index([status])
  @@index([documentNumber])
  @@map("kyc")
}

model OTP {
  id                String      @id @default(cuid())
  userId            String
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  type              OTPType
  code              String
  status            OTPStatus   @default(PENDING)
  
  email             String?
  phone             String?
  
  attempts          Int         @default(0)
  maxAttempts       Int         @default(5)
  
  expiresAt         DateTime
  verifiedAt        DateTime?

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([expiresAt])
  @@map("otps")
}

// ============================================================================
// PHASE 1: SESSION & NOTIFICATION MODELS (UNCHANGED)
// ============================================================================

model Session {
  id                String      @id @default(cuid())
  userId            String
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  token             String      @unique
  refreshToken      String?     @unique
  
  ipAddress         String?
  userAgent         String?
  deviceType        String?
  browser           String?
  
  isActive          Boolean     @default(true)
  expiresAt         DateTime
  lastActivityAt    DateTime    @default(now())

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([userId])
  @@index([token])
  @@index([isActive])
  @@index([expiresAt])
  @@map("sessions")
}

model Notification {
  id                String              @id @default(cuid())
  userId            String
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  type              NotificationType
  title             String
  message           String
  data              Json?

  isRead            Boolean             @default(false)
  readAt            DateTime?

  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([userId])
  @@index([isRead])
  @@index([type])
  @@index([createdAt])
  @@map("notifications")
}

// ============================================================================
// PHASE 1: AUDIT & ADMIN MODELS (UNCHANGED)
// ============================================================================

model AuditLog {
  id                String              @id @default(cuid())
  userId            String?
  user              User?               @relation(fields: [userId], references: [id], onDelete: SetNull)

  action            AuditLogAction
  entity            String
  entityId          String
  
  oldValues         Json?
  newValues         Json?
  changes           String?
  
  ipAddress         String?
  userAgent         String?
  
  status            String              @default("SUCCESS")
  errorMessage      String?

  createdAt         DateTime            @default(now())

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Role {
  id                String      @id @default(cuid())
  name              String      @unique
  slug              String      @unique
  description       String?
  
  isSystem          Boolean     @default(false)

  permissions       Permission[]
  users             User[]

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([slug])
  @@map("roles")
}

model Permission {
  id                String      @id @default(cuid())
  name              String      @unique
  slug              String      @unique
  description       String?
  
  module            String
  action            String
  
  isSystem          Boolean     @default(false)

  roles             Role[]

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([module])
  @@index([action])
  @@map("permissions")
}

model Setting {
  id                String      @id @default(cuid())
  key               String      @unique
  value             Json
  description       String?
  category          String?
  
  isPublic          Boolean     @default(false)
  isReadOnly        Boolean     @default(false)

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([key])
  @@index([category])
  @@map("settings")
}

// ============================================================================
// PHASE 2: AI OPERATING SYSTEM MODELS
// ============================================================================

// ============================================================================
// Workspace & Tenant Foundation
// ============================================================================

model Workspace {
  id                String            @id @default(cuid())
  name              String
  slug              String            @unique
  description       String?
  ownerId           String
  owner             User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  status            WorkspaceStatus   @default(ACTIVE)
  isDefault         Boolean           @default(false)
  settings          Json              @default("{}")

  // Relations
  agents            AIAgent[]
  conversations     Conversation[]
  workflows         Workflow[]
  knowledgeBases    KnowledgeBase[]
  apiKeys           APIKey[]
  webhooks          WebhookEndpoint[]

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?

  @@index([ownerId])
  @@index([status])
  @@map("workspaces")
}

// ============================================================================
// AI Provider & Model Management
// ============================================================================

model AIModel {
  id                String            @id @default(cuid())
  name              String            @unique
  provider          AIModelProvider
  version           String
  type              AIModelType
  description       String?

  inputTokenLimit   Int?
  outputTokenLimit  Int?
  costPerInputToken Decimal?          @db.Decimal(10, 8)
  costPerOutputToken Decimal?         @db.Decimal(10, 8)
  
  isAvailable       Boolean           @default(true)
  metadata          Json?

  // Relations
  agentVersions     AIAgentVersion[]
  messages          Message[]

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([provider])
  @@index([type])
  @@index([isAvailable])
  @@map("ai_models")
}

// ============================================================================
// AI Agent Management
// ============================================================================

model AIAgent {
  id                String            @id @default(cuid())
  name              String
  slug              String
  description       String?
  workspaceId       String
  workspace         Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy         String
  createdByUser     User              @relation("AgentCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  type              AIAgentType       @default(ASSISTANT)
  status            AIAgentStatus     @default(DRAFT)
  systemPrompt      String            @db.Text
  settings          Json              @default("{}")
  knowledgeBaseIds  String[]          @default([])
  currentVersionId  String?

  // Relations
  versions          AIAgentVersion[]
  conversations     Conversation[]

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?

  @@unique([workspaceId, slug])
  @@index([workspaceId])
  @@index([status])
  @@map("ai_agents")
}

model AIAgentVersion {
  id                String            @id @default(cuid())
  agentId           String
  agent             AIAgent           @relation(fields: [agentId], references: [id], onDelete: Cascade)
  versionNumber     Int
  systemPrompt      String            @db.Text
  settings          Json
  modelId           String
  model             AIModel           @relation(fields: [modelId], references: [id], onDelete: Restrict)
  createdBy         String
  createdByUser     User              @relation("VersionCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  changeLog         String?
  isPublished       Boolean           @default(false)

  createdAt         DateTime          @default(now())

  @@unique([agentId, versionNumber])
  @@index([agentId])
  @@index([modelId])
  @@map("ai_agent_versions")
}

// ============================================================================
// Conversation & Message Management
// ============================================================================

model Conversation {
  id                String            @id @default(cuid())
  workspaceId       String
  workspace         Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId            String
  user              User              @relation("ConversationUser", fields: [userId], references: [id], onDelete: Cascade)
  agentId           String?
  agent             AIAgent?          @relation(fields: [agentId], references: [id], onDelete: SetNull)

  title             String
  summary           String?
  status            ConversationStatus @default(ACTIVE)
  messageCount      Int               @default(0)
  lastActivityAt    DateTime          @updatedAt

  // Relations
  messages          Message[]

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?

  @@index([workspaceId])
  @@index([userId])
  @@index([agentId])
  @@index([status])
  @@map("conversations")
}

model Message {
  id                String            @id @default(cuid())
  conversationId    String
  conversation      Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role              MessageRole
  content           String            @db.Text
  tokens            Int?
  modelId           String?
  model             AIModel?          @relation(fields: [modelId], references: [id], onDelete: SetNull)
  metadata          Json?

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([conversationId])
  @@index([role])
  @@map("messages")
}

// ============================================================================
// Workflow & Task Execution
// ============================================================================

model Workflow {
  id                String            @id @default(cuid())
  name              String
  slug              String            @unique
  description       String?
  workspaceId       String
  workspace         Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy         String
  createdByUser     User              @relation("WorkflowCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  status            WorkflowStatus    @default(DRAFT)
  triggerType       WorkflowTriggerType @default(MANUAL)
  definition        String            @db.Text // JSON DAG
  cronExpression    String?
  isActive          Boolean           @default(true)

  // Relations
  executions        WorkflowExecution[]
  tasks             Task[]

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?

  @@index([workspaceId])
  @@index([status])
  @@map("workflows")
}

model WorkflowExecution {
  id                String                @id @default(cuid())
  workflowId        String
  workflow          Workflow              @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  status            WorkflowExecutionStatus @default(PENDING)
  input             Json?
  output            Json?
  error             String?
  executedBy        String?
  executedByUser    User?                 @relation("ExecutionBy", fields: [executedBy], references: [id], onDelete: SetNull)

  startedAt         DateTime              @default(now())
  completedAt       DateTime?
  durationMs        Int?

  // Relations
  tasks             Task[]

  createdAt         DateTime              @default(now())

  @@index([workflowId])
  @@index([status])
  @@index([startedAt])
  @@map("workflow_executions")
}

model Task {
  id                String                @id @default(cuid())
  executionId       String
  execution         WorkflowExecution     @relation(fields: [executionId], references: [id], onDelete: Cascade)
  workflowId        String
  workflow          Workflow              @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  taskType          TaskType
  taskName          String
  status            TaskStatus            @default(PENDING)
  input             Json?
  output            Json?
  error             String?
  
  startedAt         DateTime              @default(now())
  completedAt       DateTime?
  durationMs        Int?
  retryCount        Int                   @default(0)

  createdAt         DateTime              @default(now())

  @@index([executionId])
  @@index([workflowId])
  @@index([status])
  @@map("tasks")
}

// ============================================================================
// Knowledge Base & Document Management
// ============================================================================

model KnowledgeBase {
  id                String            @id @default(cuid())
  name              String
  slug              String            @unique
  workspaceId       String
  workspace         Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  description       String?
  createdBy         String
  createdByUser     User              @relation("KnowledgeBaseCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  documentCount     Int               @default(0)
  embeddingModel    String?
  isPublic          Boolean           @default(false)

  // Relations
  documents         KnowledgeBaseDocument[]

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?

  @@index([workspaceId])
  @@map("knowledge_bases")
}

model Document {
  id                String            @id @default(cuid())
  title             String
  workspaceId       String
  workspace         Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploadedBy        String
  uploadedByUser    User              @relation("DocumentUploadedBy", fields: [uploadedBy], references: [id], onDelete: SetNull)

  mimeType          String
  fileSize          BigInt
  storagePath       String
  status            DocumentStatus    @default(PROCESSING)
  embedding         String?
  currentVersionId  String?

  // Relations
  versions          DocumentVersion[]
  knowledgeBases    KnowledgeBaseDocument[]

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?

  @@index([workspaceId])
  @@index([status])
  @@map("documents")
}

model DocumentVersion {
  id                String            @id @default(cuid())
  documentId        String
  document          Document          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionNumber     Int
  fileSize          BigInt
  storagePath       String
  createdBy         String

  changeLog         String?

  createdAt         DateTime          @default(now())

  @@unique([documentId, versionNumber])
  @@index([documentId])
  @@map("document_versions")
}

model KnowledgeBaseDocument {
  id                String            @id @default(cuid())
  knowledgeBaseId   String
  knowledgeBase     KnowledgeBase     @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  documentId        String
  document          Document          @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([knowledgeBaseId, documentId])
  @@index([knowledgeBaseId])
  @@index([documentId])
  @@map("knowledge_base_documents")
}

// ============================================================================
// API & Webhook Integration
// ============================================================================

model APIKey {
  id                String            @id @default(cuid())
  workspaceId       String
  workspace         Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId            String?
  user              User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  name              String
  keyHash           String            @unique
  type              APIKeyType        @default(PERSONAL)
  permissions       String[]          @default([])
  
  lastUsedAt        DateTime?
  expiresAt         DateTime?
  isActive          Boolean           @default(true)

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?

  @@index([workspaceId])
  @@index([keyHash])
  @@index([type])
  @@index([isActive])
  @@map("api_keys")
}

model WebhookEndpoint {
  id                String            @id @default(cuid())
  workspaceId       String
  workspace         Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  url               String
  events            String[]          @default([])
  isActive          Boolean           @default(true)
  secret            String
  
  retryCount        Int               @default(3)
  retryDelaySeconds Int               @default(60)
  lastTriggeredAt   DateTime?

  // Relations
  logs              WebhookLog[]

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([workspaceId, url])
  @@index([workspaceId])
  @@map("webhook_endpoints")
}

model WebhookLog {
  id                String            @id @default(cuid())
  webhookEndpointId String
  webhookEndpoint   WebhookEndpoint   @relation(fields: [webhookEndpointId], references: [id], onDelete: Cascade)

  event             String
  payload           String            @db.Text
  httpStatus        Int?
  response          String?
  attempt           Int               @default(1)
  nextRetryAt       DateTime?
  succeededAt       DateTime?

  createdAt         DateTime          @default(now())

  @@index([webhookEndpointId])
  @@index([succeededAt])
  @@map("webhook_logs")
}
