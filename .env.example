# Application
NODE_ENV=development
APP_NAME=qgos
APP_VERSION=1.0.0
PORT=3000
HOST=localhost

# Database
DATABASE_URL=postgresql://qgos:qgos@localhost:5432/qgos_dev
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=qgos
DATABASE_PASSWORD=qgos
DATABASE_NAME=qgos_dev

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRATION=7d

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Logging
LOG_LEVEL=debug