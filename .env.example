# Application
NODE_ENV=development
APP_NAME=qgos
APP_VERSION=1.0.0
PORT=3000
HOST=0.0.0.0

# Database
DATABASE_URL=postgresql://qgos:qgos@localhost:5432/qgos_dev
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=qgos
DATABASE_PASSWORD=qgos
DATABASE_NAME=qgos_dev

# JWT - replace in every non-local environment
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRATION=7d

# Initial admin seed password - development/local only
ADMIN_INITIAL_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Logging
LOG_LEVEL=debug
